{
  "name": "qa-automation-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Automatización de APIs con Playwright y Cucumber, y pruebas de performance con k6",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:fakestore": "cucumber-js --tags @fakestore",
    "test:gorest": "cucumber-js --tags @gorest"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.10",
    "multiple-cucumber-html-reporter": "^4.7.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
