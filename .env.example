# Copia este archivo como .env y completa los valores. El .env no se versiona.

# Ambiente: dev | qa | staging | prod
TEST_ENV=qa

# URLs base
FAKESTORE_BASE_URL=https://fakestoreapi.com
GOREST_BASE_URL=https://gorest.co.in

# Token de GoRest con permisos de v2 (https://gorest.co.in)
GOREST_TOKEN=

# Tiempo máximo por petición, en milisegundos
REQUEST_TIMEOUT_MS=15000
